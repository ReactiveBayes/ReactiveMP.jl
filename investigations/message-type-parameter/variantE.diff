+
+## Variant C: function barriers ("kernel functions") over the unpacked data.
+#
+# The untyped `Message`/`Marginal` hide their data's type from the compiler. The engine unpacks
+# the data into a tuple once, and passes it to a kernel with one method: the call is one dynamic
+# dispatch, and the kernel is compiled for the concrete types of the data, so building
+# `RuleArgs`, resolving the rule and running it are all static inside it.
+
+# The inputs' data, and their annotations, as tuples; `nothing` stays `nothing`.
+data_of(::Nothing) = nothing
+data_of(inputs::Tuple) = map(getdata, inputs)
+annotations_of(::Nothing) = nothing
+annotations_of(inputs::Tuple) = map(getannotations, inputs)
+
+# Reads an input that is already the data.
+struct AsData end
+(::AsData)(data) = data
+block_value(::AsData, data, block) = data[block]
+
+# Barrier: the missing check over the unpacked data, compiled per data types.
+has_missing_data(::Nothing) = false
+has_missing_data(data::Tuple) = any(ismissing, TupleTools.flatten(data))
+
+# The kernel's `Marginals`: `inputs` are the data (`AsData()`) or the annotations (`identity`),
+# `data` the data, whose types say which joints are factorised clusters.
+kernel_marginals(f, ::Nothing, ::Nothing, ::Nothing) = Marginals(NamedTuple())
+kernel_marginals(f, names::Val, inputs::Tuple, data::Tuple) = rule_marginals(f, names, inputs, data)
+
+kernel_arguments(mnames, mdata, qnames, qdata) =
+    RuleArgs(rule_messages(AsData(), mnames, mdata), kernel_marginals(AsData(), qnames, qdata, qdata))
+kernel_annotations(mnames, mann, qnames, qann, qdata, out) =
+    RuleAnnotations(rule_messages(identity, mnames, mann), kernel_marginals(identity, qnames, qann, qdata), out)
