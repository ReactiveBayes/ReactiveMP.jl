index b9d27b70..4c3ee95f 100644
--- a/src/callbacks.jl
+++ b/src/callbacks.jl
@@ -53,6 +53,14 @@ Does nothing and returns the event if `callbacks` is `nothing`.
 
 See also: [`ReactiveMP.handle_event`](@ref), [`ReactiveMP.Event`](@ref), [`ReactiveMP.merge_callbacks`](@ref)
 """
+# Builds the event only when there are callbacks to hand it to: an event whose fields are
+# inferred abstractly is instantiated at run time, which costs even when nothing listens.
+macro invoke_callback(callbacks, event)
+    return esc(:(let cb = $callbacks
+        cb === nothing ? nothing : invoke_callback(cb, $event)
+    end))
+end
+
 function invoke_callback(callbacks::Nothing, event::Event)
     return event
 end
