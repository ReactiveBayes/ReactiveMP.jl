diff --git a/src/helpers/stackguard.jl b/src/helpers/stackguard.jl
new file mode 100644
index 00000000..4dfd61bf
--- /dev/null
+++ b/src/helpers/stackguard.jl
@@ -0,0 +1,59 @@
+export stackguarded, set_stack_guard_limit!
+
+# A chain of subscriptions (or of emissions) nests one call inside the next, so a long enough
+# chain overflows the stack. `stackguarded(f)` counts how deep such calls are nested; past the
+# limit it runs `f` on a fresh task, with a fresh stack, and waits for it, so the caller sees
+# the same synchronous result. Only the current thread's nesting is counted: Rocket's streams
+# are not thread-safe, and the fresh task runs on the same thread.
+mutable struct StackGuard
+    depth::Int
+    limit::Int
+end
+
+const STACK_GUARD = StackGuard(0, 256)
+
+"""
+    set_stack_guard_limit!(limit::Int)
+
+Sets how many [`stackguarded`](@ref) calls may nest before the next one runs on a fresh task;
+`typemax(Int)` turns the guard off. Returns the previous limit.
+"""
+function set_stack_guard_limit!(limit::Int)
+    previous = STACK_GUARD.limit
+    STACK_GUARD.limit = limit
+    return previous
+end
+
+"""
+    stackguarded(f)
+
+Calls `f()` and returns its result; when more than the limit of such calls are already nested
+(see [`set_stack_guard_limit!`](@ref)), on a fresh task, which the caller waits for.
+"""
+@inline function stackguarded(f::F) where {F}
+    guard = STACK_GUARD
+    guard.depth >= guard.limit && return _stackguarded_on_task(f)
+    guard.depth += 1
+    try
+        return f()
+    finally
+        guard.depth -= 1
+    end
+end
+
+@noinline function _stackguarded_on_task(f::F) where {F}
+    guard = STACK_GUARD
+    saved = guard.depth
+    guard.depth = 0
+    task = Task(f)
+    schedule(task)
+    try
+        wait(task)
+    catch exception
+        exception isa TaskFailedException && throw(task.exception)
+        rethrow()
+    finally
+        guard.depth = saved
+    end
+    return task.result
+end
