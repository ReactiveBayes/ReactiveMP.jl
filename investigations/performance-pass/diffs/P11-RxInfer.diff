@@ -0,0 +1,39 @@
+using PrecompileTools: @setup_workload, @compile_workload
+
+# A few small models of the kinds most users start with, so that their first inference reuses
+# native code cached at precompile time instead of compiling the engine's generic machinery.
+@model function __precompile_ssm(y)
+    x_prev ~ Normal(mean = 0.0, variance = 100.0)
+    for i in eachindex(y)
+        x[i] ~ Normal(mean = x_prev, variance = 1.0)
+        y[i] ~ Normal(mean = x[i], variance = 1.0)
+        x_prev = x[i]
+    end
+end
+@model function __precompile_iid(y)
+    μ ~ Normal(mean = 0.0, variance = 100.0)
+    τ ~ Gamma(shape = 1.0, rate = 1.0)
+    for i in eachindex(y)
+        y[i] ~ Normal(mean = μ, precision = τ)
+    end
+end
+@model function __precompile_betabern(y)
+    θ ~ Beta(1.0, 1.0)
+    for i in eachindex(y)
+        y[i] ~ Bernoulli(θ)
+    end
+end
+
+@setup_workload begin
+    y = [0.1, -0.2, 0.3, 0.05, -0.1]
+    @compile_workload begin
+        for fe in (false, Float64)
+            infer(model = __precompile_ssm(), data = (y = y,), free_energy = fe, session = nothing)
+            infer(
+                model = __precompile_iid(), data = (y = y,), constraints = MeanField(), iterations = 2,
+                initialization = @initialization(q(τ) = GammaShapeRate(1.0, 1.0)), free_energy = fe, session = nothing,
+            )
+            infer(model = __precompile_betabern(), data = (y = [1.0, 0.0, 1.0],), free_energy = fe, session = nothing)
+        end
+    end
+end
