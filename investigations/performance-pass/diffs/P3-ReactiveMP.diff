+"""
+    execute_rule(then, spec::RuleSpec, output, scratch, algorithm, ctx, args, ann, target)
+
+`then(execute_rule(spec, output, scratch, algorithm, ctx, args, ann, target))`, with the body and
+`then` called behind one function barrier specialised on the body's type: the body's result is
+inferred there, so `then` runs on a concretely typed value. An engine passes what it does with
+the result as `then`, rather than receiving a value inferred `Any`.
+"""
+@inline execute_rule(then::F, spec::RuleSpec, output, scratch, algorithm, ctx, args, ann, target) where {F} =
+    execute_rule_then(spec.body, then, spec, output, scratch, algorithm, ctx, args, ann, target)
+
+@noinline function execute_rule_then(body::B, then::F, spec::RuleSpec, output, scratch, algorithm, ctx, args, ann, target) where {B, F}
+    if spec.inplace && output === nothing
+        output = spec.prealloc(algorithm, ctx, args, target)
+    end
+    if scratch === nothing
+        scratch = rule_scratch(spec, algorithm, ctx, args, target)
+    end
+    return then(unwrap_result(spec, body(output, scratch, algorithm, ctx, args, ann, target)))
+end
+
 # The body's raw return, a `WithLogScale` for a rule declared `from_body`, and the scratch it ran with.
 @inline function execute_rule_body(spec::RuleSpec, output, scratch, algorithm, ctx, args, ann, target)
     if spec.inplace && output === nothing
