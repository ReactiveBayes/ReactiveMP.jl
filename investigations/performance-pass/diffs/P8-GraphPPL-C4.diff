+"""
+    NodeExtras()
+
+The extra properties of a node, keyed by `Symbol`. A node carries a handful of them, so they are
+kept as pairs in one vector and found by a linear scan: one small allocation per node where a
+hash table allocates several, and a scan over a few keys is faster than hashing. It supports
+`haskey`, `getindex`, `get`, `insert!` (which throws if the key is present), `isempty`, `length`,
+`keys`, `values`, `pairs` and iteration over the values, as a `Dictionaries.AbstractDictionary`.
+"""
+struct NodeExtras
+    entries::Vector{Pair{Symbol, Any}}
+end
+
+NodeExtras() = NodeExtras(Pair{Symbol, Any}[])
+
+function extras_slot(extras::NodeExtras, key::Symbol)
+    entries = extras.entries
+    @inbounds for i in eachindex(entries)
+        first(entries[i]) === key && return i
+    end
+    return 0
+end
+
+Base.haskey(extras::NodeExtras, key::Symbol) = extras_slot(extras, key) !== 0
+function Base.getindex(extras::NodeExtras, key::Symbol)
+    i = extras_slot(extras, key)
+    i === 0 && throw(IndexError("NodeExtras has no key :$key"))
+    return last(@inbounds extras.entries[i])
+end
+function Base.get(extras::NodeExtras, key::Symbol, default)
+    i = extras_slot(extras, key)
+    return i === 0 ? default : last(@inbounds extras.entries[i])
+end
+function Base.insert!(extras::NodeExtras, key::Symbol, value)
+    extras_slot(extras, key) === 0 || throw(IndexError("NodeExtras already contains the key :$key"))
+    push!(extras.entries, key => value)
+    return extras
+end
+Base.isempty(extras::NodeExtras) = isempty(extras.entries)
+Base.length(extras::NodeExtras) = length(extras.entries)
+Base.keys(extras::NodeExtras) = map(first, extras.entries)
+Base.values(extras::NodeExtras) = map(last, extras.entries)
+Base.pairs(extras::NodeExtras) = extras.entries
+Base.iterate(extras::NodeExtras, state...) = iterate(Iterators.map(last, extras.entries), state...)
+function Base.show(io::IO, extras::NodeExtras)
+    print(io, "NodeExtras(")
+    join(io, (string(k, " = ", repr(v)) for (k, v) in extras.entries), ", ")
+    print(io, ")")
+end
+
