 ## Stochastic mapping
 
+# The node's score from its average energy, minus the entropies of its clusters: run inside the
+# rule's function barrier, on a concretely typed average energy.
+struct EnergyTail{T, M}
+    marginals::M
+end
+
+function (tail::EnergyTail{T})(average_energy) where {T}
+    clusters_entropy = mapreduce(marginal -> score(DifferentialEntropy(), marginal), +, tail.marginals)
+    return convert(T, average_energy - clusters_entropy)
+end
