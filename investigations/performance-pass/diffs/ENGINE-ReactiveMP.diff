+"""
+    execute_rule(then, spec::RuleSpec, output, scratch, algorithm, ctx, args, ann, target)
+
+`then(execute_rule(spec, output, scratch, algorithm, ctx, args, ann, target))`, with the body and
+`then` called behind one function barrier specialised on the body's type: the body's result is
+inferred there, so `then` runs on a concretely typed value. An engine passes what it does with
+the result as `then`, rather than receiving a value inferred `Any`.
+"""
+@inline execute_rule(then::F, spec::RuleSpec, output, scratch, algorithm, ctx, args, ann, target) where {F} =
+    execute_rule_then(
+        spec.body, then, spec.inplace ? spec.prealloc : nothing, scratch === nothing ? spec.scratch : nothing,
+        spec.logscale isa FromBody, output, scratch, algorithm, ctx, args, ann, target,
+    )
+
+# The barrier takes the few fields it needs rather than the `RuleSpec`: an immutable struct of
+# eighteen fields passed to a call dispatched at run time is copied into a fresh box every time.
+@noinline function execute_rule_then(body::B, then::F, prealloc, scratchfn, from_body::Bool, output, scratch, algorithm, ctx, args, ann, target) where {B, F}
+    if prealloc !== nothing && output === nothing
+        output = prealloc(algorithm, ctx, args, target)
+    end
+    if scratchfn !== nothing
+        scratch = scratchfn(algorithm, ctx, args, target)
+    end
+    raw = body(output, scratch, algorithm, ctx, args, ann, target)
+    return then(unwrap_body_result(from_body, raw))
+end
+
+@inline unwrap_body_result(from_body::Bool, raw::WithLogScale) =
+    from_body ? raw.result : throw(ArgumentError("a rule returned `with_logscale(...)` but does not declare `logscale = from_body`"))
+@inline unwrap_body_result(from_body::Bool, raw) =
+    from_body ? throw(ArgumentError("a rule declares `logscale = from_body` but its body did not return `with_logscale(result, logscale)`")) : raw
+
 # The body's raw return, a `WithLogScale` for a rule declared `from_body`, and the scratch it ran with.
 @inline function execute_rule_body(spec::RuleSpec, output, scratch, algorithm, ctx, args, ann, target)
     if spec.inplace && output === nothing
