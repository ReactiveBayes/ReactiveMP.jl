+# What creating a node of one type from the same interface keys and factorisation always gives,
+# since it depends on nothing else (a node that folds its static inputs depends on its
+# variables' kinds, and is never planned): where each processed interface comes from in the
+# given ones, the vector's element type, the clusters and their keys. A graph creates the same
+# few shapes of node many times, so each is resolved and checked once.
+# A plan also keeps the dependencies each target resolved to, under each dependency declaration
+# (`ReactiveMP.planned_dependencies`).
+struct CreationPlan{T, C, K}
+    order::Vector{Tuple{Int, Symbol, Int}}
+    clusters::C
+    keys::K
+    dependencies::Dict{Tuple{UInt, Int}, Any}
+    CreationPlan{T}(order, clusters::C, keys::K) where {T, C, K} = new{T, C, K}(order, clusters, keys, Dict{Tuple{UInt, Int}, Any}())
+end
