diff --git a/src/helpers/stackguard.jl b/src/helpers/stackguard.jl
index 4dfd61bf..2058d630 100644
--- a/src/helpers/stackguard.jl
+++ b/src/helpers/stackguard.jl
@@ -25,27 +25,29 @@ function set_stack_guard_limit!(limit::Int)
 end
 
 """
-    stackguarded(f)
+    stackguarded(f, args...)
 
-Calls `f()` and returns its result; when more than the limit of such calls are already nested
-(see [`set_stack_guard_limit!`](@ref)), on a fresh task, which the caller waits for.
+Calls `f(args...)` and returns its result; when more than the limit of such calls are already
+nested (see [`set_stack_guard_limit!`](@ref)), on a fresh task, which the caller waits for.
+Passing the arguments rather than a closure over them spares building a closure, whose type
+depends on theirs, on every call.
 """
-@inline function stackguarded(f::F) where {F}
+@inline function stackguarded(f::F, args::Vararg{Any, N}) where {F, N}
     guard = STACK_GUARD
-    guard.depth >= guard.limit && return _stackguarded_on_task(f)
+    guard.depth >= guard.limit && return _stackguarded_on_task(f, args)
     guard.depth += 1
     try
-        return f()
+        return f(args...)
     finally
         guard.depth -= 1
     end
 end
 
-@noinline function _stackguarded_on_task(f::F) where {F}
+@noinline function _stackguarded_on_task(f::F, args::Tuple) where {F}
     guard = STACK_GUARD
     saved = guard.depth
     guard.depth = 0
-    task = Task(f)
+    task = Task(() -> f(args...))
     schedule(task)
     try
         wait(task)
